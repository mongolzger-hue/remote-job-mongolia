# Optional: leave both blank to use the local demo store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Required in production; local development defaults to local-demo-admin.
ADMIN_PASSWORD=
SITE_URL=http://localhost:3000
# Run node scripts/setup-admin.mjs to create these securely in .env.local.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
SESSION_SECRET=
# Independent random backup encryption key, minimum 32 characters.
BACKUP_KEY=
SUPPORT_EMAIL=
GOOGLE_SITE_VERIFICATION=
# Only for a single persistent local production-mode test; never serverless hosting.
ALLOW_LOCAL_STORAGE=false
# Public Supabase publishable key for cookie-based user authentication (never the service key).
SUPABASE_PUBLISHABLE_KEY=
# Enable only after custom SMTP and auth redirect URLs have been configured and tested.
MEMBER_SIGNUP_ENABLED=false
